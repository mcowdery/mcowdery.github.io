---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Experience" description="Professional experience of Mathew Cowdery.">
  <div class="wrap page-head">
    <p class="eyebrow">Background</p>
    <h1>Experience</h1>
    <p class="lead">A summary of where I am now. My full work history is on LinkedIn.</p>
    <div class="actions"><a class="button" href={site.linkedin}>Full history on LinkedIn →</a></div>
  </div>
  <div class="wrap" style="padding-bottom:72px">
    <ol class="timeline">
      <li>
        <article class="card">
          <p class="meta">Current</p>
          <h3>DevOps Engineer, BAE Systems</h3>
          <p>
            DevOps engineering in a regulated aerospace environment: containerized services, compliance-driven
            CI/CD pipelines, and Python backend APIs. Growing into DevSecOps through container vulnerability
            remediation (Trivy) and contributions to NIST 800-171 and authorization-to-operate (ATO) compliance efforts.
          </p>
          <ul class="tags">
            <li>Docker</li><li>Kubernetes</li><li>GitHub Actions</li><li>GitLab CI</li><li>Python</li><li>FastAPI</li><li>Trivy</li>
          </ul>
        </article>
      </li>
      <li>
        <article class="card">
          <p class="meta">In progress</p>
          <h3>MS, Management &amp; Policy (Translator track)</h3>
          <p>Purdue University, graduating after Spring 2027.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <p class="meta">In progress</p>
          <h3>AIGP (IAPP), AI governance certification</h3>
          <p>In progress, as part of the move into AI governance and policy.</p>
        </article>
      </li>
      <li>
        <article class="card">
          <p class="meta">Service</p>
          <h3>U.S. Navy veteran</h3>
        </article>
      </li>
    </ol>
  </div>
</Base>
