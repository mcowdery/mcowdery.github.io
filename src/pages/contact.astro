---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Contact" description="Contact Mathew Cowdery.">
  <div class="banner">
    <img class="banner-photo" src="/photos/contact.jpg" alt="" width="1792" height="640" fetchpriority="high" />
    <div class="banner-shade"></div>
    <div class="wrap page-head">
      <p class="eyebrow">Say hello</p>
      <h1>Contact</h1>
      <p class="lead">I'm interested in DevOps, DevSecOps, and AI governance and policy roles. Email is the best way to reach me.</p>
    </div>
  </div>
  <div class="wrap" style="padding-block:48px 72px">
    <div class="grid cols-3">
      <a class="card contact-card" href={`mailto:${site.email}`}>
        <span class="label">Email</span><span class="value">{site.email}</span><p class="hint">Best for first contact</p>
      </a>
      <a class="card contact-card" href={site.linkedin}>
        <span class="label">LinkedIn</span><span class="value">mathewcowdery</span><p class="hint">Full work history</p>
      </a>
      <a class="card contact-card" href={site.github}>
        <span class="label">GitHub</span><span class="value">mcowdery</span><p class="hint">Code and projects</p>
      </a>
    </div>
  </div>
</Base>
