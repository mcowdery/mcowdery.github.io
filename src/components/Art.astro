---
// Hand-drawn SVG illustrations. Colours come from the theme tokens, so they follow light/dark.
interface Props { kind: string; class?: string }
const { kind, class: cls } = Astro.props;
const id = `g-${kind}`;
---
{kind === 'hero' && (
  <svg class={cls} viewBox="0 0 1200 520" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <defs>
      <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" stop-color="var(--accent)" />
        <stop offset="1" stop-color="var(--accent-2)" />
      </linearGradient>
      <linearGradient id={`${id}-fade`} x1="0" x2="1">
        <stop offset="0" stop-color="#fff" stop-opacity="0" />
        <stop offset=".5" stop-color="#fff" stop-opacity=".12" />
        <stop offset=".75" stop-color="#fff" stop-opacity="1" />
      </linearGradient>
      <mask id={`${id}-mask`}><rect width="1200" height="520" fill={`url(#${id}-fade)`} /></mask>
    </defs>
    <g mask={`url(#${id}-mask)`} fill="none" stroke={`url(#${id})`} stroke-width="1.4" opacity=".7">
      <path d="M500 380 C620 380 620 250 740 250 S860 120 980 140 S1100 260 1160 230" />
      <path d="M500 380 C640 400 700 470 820 430 S980 360 1060 400" />
      <path d="M740 250 C800 330 880 300 940 330 S1040 300 1060 400" />
      <path d="M740 250 C760 170 840 70 920 60 S1040 90 1100 70" />
      <path d="M980 140 C1000 90 1060 60 1100 70" />
      <path d="M820 430 C860 480 940 490 1010 470" />
      <path d="M560 160 C640 170 690 210 740 250" />
      <path d="M560 160 C610 100 700 70 780 90 S900 60 920 60" />
    </g>
    <g mask={`url(#${id}-mask)`}>
      {[[500,380,9],[740,250,12],[980,140,9],[1160,230,6],[820,430,9],[1060,400,10],[920,60,8],[1100,70,6],[560,160,8],[940,330,6],[1010,470,5],[780,90,5]].map(([x, y, r], i) => (
        <g>
          <circle cx={x} cy={y} r={Number(r) + 9} fill={`url(#${id})`} opacity=".12" />
          <circle cx={x} cy={y} r={r} fill="var(--surface)" stroke={i % 2 ? 'var(--accent-2)' : 'var(--accent)'} stroke-width="2" />
        </g>
      ))}
    </g>
  </svg>
)}

{kind === 'ad' && (
  <svg class={cls} viewBox="0 0 400 170" role="img" aria-label="Network packets scanned for suspicious patterns">
    <rect width="400" height="170" fill="var(--bg)" />
    <circle cx="340" cy="30" r="90" fill="var(--accent)" opacity=".08" />
    {[0, 1, 2, 3].map((row) => (
      <g>
        {Array.from({ length: 13 }).map((_, i) => {
          const flagged = (row === 1 && (i === 6 || i === 7 || i === 9)) || (row === 2 && i === 8);
          return <rect x={18 + i * 29} y={26 + row * 32} width="21" height="14" rx="3"
            fill={flagged ? 'var(--accent-2)' : 'var(--line)'} opacity={flagged ? 1 : 0.9} />;
        })}
      </g>
    ))}
    <rect x="186" y="14" width="86" height="142" rx="8" fill="none" stroke="var(--accent)" stroke-width="2" stroke-dasharray="6 5" />
    <text x="193" y="164" font-family="var(--mono)" font-size="9" fill="var(--accent)">sliding window</text>
    <path d="M320 112 l18 -8 l18 8 v18 c0 14 -10 22 -18 26 c-8 -4 -18 -12 -18 -26z" fill="var(--surface)" stroke="var(--accent)" stroke-width="2" transform="translate(0 -30)" />
    <path d="M330 94 l6 6 l12 -12" fill="none" stroke="var(--accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" transform="translate(0 -7)" />
  </svg>
)}

{kind === 'wood' && (
  <svg class={cls} viewBox="0 0 400 170" role="img" aria-label="Tree rings beside a moisture gauge">
    <rect width="400" height="170" fill="var(--bg)" />
    <circle cx="90" cy="150" r="130" fill="var(--accent-2)" opacity=".07" />
    {[62, 52, 43, 34, 26, 18, 11, 5].map((r, i) => (
      <ellipse cx="110" cy="85" rx={r * 1.15} ry={r} fill="none" stroke={i % 3 === 0 ? 'var(--accent-2)' : 'var(--accent)'} stroke-width="2" opacity={0.35 + i * 0.08} />
    ))}
    <rect x="215" y="28" width="150" height="14" rx="7" fill="var(--line)" />
    <rect x="215" y="28" width="104" height="14" rx="7" fill="var(--accent)" />
    <rect x="215" y="62" width="150" height="14" rx="7" fill="var(--line)" />
    <rect x="215" y="62" width="62" height="14" rx="7" fill="var(--accent-2)" />
    <rect x="215" y="96" width="150" height="14" rx="7" fill="var(--line)" />
    <rect x="215" y="96" width="132" height="14" rx="7" fill="var(--accent)" />
    <text x="215" y="132" font-family="var(--mono)" font-size="9" fill="var(--muted)">drying  ·  ready  ·  archived</text>
    <circle cx="372" cy="35" r="3" fill="var(--accent-2)" />
  </svg>
)}

{kind === 'agent' && (
  <svg class={cls} viewBox="0 0 400 170" role="img" aria-label="Parallel git branches merging back into main">
    <rect width="400" height="170" fill="var(--bg)" />
    <circle cx="60" cy="150" r="110" fill="var(--accent)" opacity=".07" />
    <g fill="none" stroke-width="3" stroke-linecap="round">
      <path d="M24 85 H376" stroke="var(--muted)" opacity=".5" />
      <path d="M90 85 C115 85 115 36 145 36 H255 C285 36 285 85 310 85" stroke="var(--accent)" />
      <path d="M110 85 C135 85 135 134 165 134 H235 C265 134 265 85 290 85" stroke="var(--accent-2)" />
    </g>
    {[[24,85,'m'],[90,85,'m'],[310,85,'m'],[376,85,'m'],[145,36,'a'],[200,36,'a'],[255,36,'a'],[165,134,'b'],[200,134,'b'],[235,134,'b']].map(([x, y, t]) => (
      <circle cx={x} cy={y} r="7" fill="var(--surface)" stroke={t === 'a' ? 'var(--accent)' : t === 'b' ? 'var(--accent-2)' : 'var(--muted)'} stroke-width="2.5" />
    ))}
    <g transform="translate(176 104)">
      <rect width="48" height="30" rx="6" fill="var(--surface)" stroke="var(--line)" />
      <rect x="15" y="12" width="18" height="12" rx="2" fill="var(--accent-2)" />
      <path d="M19 12 v-4 a5 5 0 0 1 10 0 v4" fill="none" stroke="var(--accent-2)" stroke-width="2" />
    </g>
    <text x="24" y="72" font-family="var(--mono)" font-size="9" fill="var(--muted)">main</text>
  </svg>
)}

{kind === 'guard' && (
  <svg class={cls} viewBox="0 0 400 170" role="img" aria-label="Three model tiers with a threshold gate">
    <rect width="400" height="170" fill="var(--bg)" />
    <circle cx="330" cy="150" r="110" fill="var(--accent-2)" opacity=".08" />
    <rect x="48" y="104" width="72" height="42" rx="8" fill="var(--accent)" opacity=".45" />
    <rect x="164" y="72" width="72" height="74" rx="8" fill="var(--accent)" opacity=".7" />
    <rect x="280" y="34" width="72" height="112" rx="8" fill="var(--accent)" />
    <g font-family="var(--mono)" font-size="10" fill="var(--muted)" text-anchor="middle">
      <text x="84" y="162">haiku</text><text x="200" y="162">sonnet</text><text x="316" y="162">opus</text>
    </g>
    <path d="M30 88 H382" stroke="var(--accent-2)" stroke-width="2" stroke-dasharray="6 5" />
    <g transform="translate(142 56)"><path d="M0 8 l8 -8 l8 8 l-8 8z" fill="var(--accent-2)" /></g>
    <text x="30" y="80" font-family="var(--mono)" font-size="9" fill="var(--accent-2)">confidence threshold</text>
  </svg>
)}

{kind === 'callout' && (
  <svg class={cls} viewBox="0 0 320 240" preserveAspectRatio="xMaxYMid slice" aria-hidden="true">
    <g fill="none" stroke="var(--accent-2)" stroke-width="2" stroke-linecap="round">
      <rect x="150" y="30" width="130" height="180" rx="10" />
      <path d="M170 64 H260 M170 86 H244 M170 108 H262 M170 130 H230 M170 152 H254 M170 174 H220" opacity=".7" />
    </g>
    <g fill="var(--surface)" stroke="var(--accent)" stroke-width="2">
      <circle cx="108" cy="70" r="9" /><circle cx="86" cy="130" r="7" /><circle cx="116" cy="184" r="10" />
    </g>
    <g fill="none" stroke="var(--accent)" stroke-width="1.6" opacity=".7">
      <path d="M117 72 C135 76 150 80 168 86" /><path d="M93 130 C125 130 145 130 168 130" /><path d="M125 182 C140 176 155 168 168 152" />
    </g>
  </svg>
)}

{kind === 'devops' && (
  <svg class={cls} viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="12" fill="var(--accent-soft)" />
    <g fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 11 l11 6 v12 l-11 6 l-11 -6 v-12z" /><path d="M24 23 v12 M24 23 l-11 -6 M24 23 l11 -6" opacity=".7" />
    </g>
  </svg>
)}
{kind === 'security' && (
  <svg class={cls} viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="12" fill="var(--accent-soft)" />
    <g fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 10 l11 4 v9 c0 8 -5 13 -11 15 c-6 -2 -11 -7 -11 -15 v-9z" /><path d="M19 24 l4 4 l7 -8" />
    </g>
  </svg>
)}
{kind === 'governance' && (
  <svg class={cls} viewBox="0 0 48 48" aria-hidden="true">
    <rect width="48" height="48" rx="12" fill="var(--accent-soft)" />
    <g fill="none" stroke="var(--accent)" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
      <path d="M24 11 v26 M16 37 h16 M13 18 h22" /><path d="M13 18 l-4 9 a5 5 0 0 0 8 0z M35 18 l-4 9 a5 5 0 0 0 8 0z" />
    </g>
  </svg>
)}
